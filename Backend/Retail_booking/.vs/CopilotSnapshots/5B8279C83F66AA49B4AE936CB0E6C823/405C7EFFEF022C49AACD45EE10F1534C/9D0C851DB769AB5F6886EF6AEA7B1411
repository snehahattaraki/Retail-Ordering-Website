using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using Microsoft.EntityFrameworkCore;
using RetailOrdering.Infrastructure.Data;
using RetailOrdering.Domain.Entities;
using RetailOrdering.Application.Interfaces;
using RetailOrdering.API.Responses;

namespace RetailOrdering.API.Controllers;

[ApiController]
[Route("api/[controller]")]
[Authorize]
public class OrdersController : ControllerBase
{
    private readonly AppDbContext _context;
    private readonly IEmailService _emailService;

    public OrdersController(AppDbContext context, IEmailService emailService)
    {
        _context = context;
        _emailService = emailService;
    }

    private int GetUserId() => int.Parse(User.Claims.First(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier).Value);

    [HttpPost("place")]
    public async Task<IActionResult> PlaceOrder()
    {
        var userId = GetUserId();
        var cart = await _context.Carts.Include(c => c.CartItems).ThenInclude(ci => ci.Product).FirstOrDefaultAsync(c => c.UserId == userId);
        if (cart == null || !cart.CartItems.Any()) return BadRequest(ApiResponse<string>.FailResponse("Cart is empty"));

        // verify stock
        foreach (var ci in cart.CartItems)
        {
            if (ci.Product.StockQty < ci.Quantity) return BadRequest(ApiResponse<string>.FailResponse($"Product {ci.Product.Name} is out of stock"));
        }

        var order = new Order
        {
            UserId = userId,
            TotalAmount = cart.CartItems.Sum(ci => ci.Quantity * ci.Product.Price),
            Status = OrderStatus.Confirmed,
            CreatedAt = DateTime.UtcNow
        };

        await _context.Orders.AddAsync(order);
        await _context.SaveChangesAsync();

        foreach (var ci in cart.CartItems)
        {
            var oi = new OrderItem { OrderId = order.Id, ProductId = ci.ProductId, Quantity = ci.Quantity, Price = ci.Product.Price };
            await _context.OrderItems.AddAsync(oi);
            // reduce stock
            ci.Product.StockQty -= ci.Quantity;
            _context.Products.Update(ci.Product);
        }

        // Clear cart
        _context.CartItems.RemoveRange(cart.CartItems);
        await _context.SaveChangesAsync();

        // add loyalty points
        var lp = await _context.LoyaltyPoints.FirstOrDefaultAsync(l => l.UserId == userId);
        if (lp == null)
        {
            lp = new LoyaltyPoint { UserId = userId, Points = (int)order.TotalAmount };
            await _context.LoyaltyPoints.AddAsync(lp);
        }
        else
        {
            lp.Points += (int)order.TotalAmount;
            _context.LoyaltyPoints.Update(lp);
        }

        await _context.SaveChangesAsync();

        // send email
        var user = await _context.Users.FindAsync(userId);
        if (user != null)
        {
            await _emailService.SendEmailAsync(user.Email, "Order Confirmation", $"Your order {order.Id} is placed.");
        }

        return Ok(ApiResponse<object>.SuccessResponse(new { orderId = order.Id }, "Order placed"));
    }

    [HttpGet]
    public async Task<IActionResult> GetOrders()
    {
        Console.WriteLine("AUTH HEADER: " + Request.Headers["Authorization"].ToString());
        Console.WriteLine("USER AUTHENTICATED: " + (User.Identity?.IsAuthenticated ?? false));
        Console.WriteLine("USER ROLE: " + User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value);

        var userId = GetUserId();
        var orders = await _context.Orders.Include(o => o.OrderItems).Where(o => o.UserId == userId).ToListAsync();
        return Ok(ApiResponse<object>.SuccessResponse(orders));
    }

    [HttpGet("{id}")]
    public async Task<IActionResult> Get(int id)
    {
        var userId = GetUserId();
        var order = await _context.Orders.Include(o => o.OrderItems).ThenInclude(oi => oi.Product).FirstOrDefaultAsync(o => o.Id == id && o.UserId == userId);
        if (order == null) return NotFound(ApiResponse<string>.FailResponse("Order not found"));
        return Ok(ApiResponse<object>.SuccessResponse(order));
    }
}
