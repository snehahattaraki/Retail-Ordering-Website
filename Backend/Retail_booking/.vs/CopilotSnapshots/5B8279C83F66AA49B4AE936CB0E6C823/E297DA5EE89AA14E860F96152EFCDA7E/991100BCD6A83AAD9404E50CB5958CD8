using System.Security.Claims;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using RetailOrdering.API.Responses;
using RetailOrdering.Application.DTOs.Common;
using RetailOrdering.Application.DTOs.Product;
using RetailOrdering.Application.Interfaces;

namespace RetailOrdering.API.Controllers;

[ApiController]
[Route("api/[controller]")]
public class ProductsController : ControllerBase
{
    private readonly IProductService _productService;

    public ProductsController(IProductService productService)
    {
        _productService = productService;
    }

    /// <summary>
    /// Get products with pagination, search, category and brand filters
    /// </summary>
    [HttpGet]
    public async Task<IActionResult> GetProducts(
        [FromQuery] int page = 1,
        [FromQuery] int pageSize = 10,
        [FromQuery] string? search = null,
        [FromQuery] string? category = null,
        [FromQuery] string? brand = null)
    {
        try
        {
            if (page < 1) page = 1;
            if (pageSize < 1) pageSize = 10;
            if (pageSize > 100) pageSize = 100;

            var result = await _productService.GetProductsAsync(page, pageSize, search, category, brand);
            return Ok(ApiResponse<PaginationResponseDto<ProductDto>>.SuccessResponse(result, "Products retrieved"));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR in GetProducts: {ex.Message}");
            return StatusCode(500, ApiResponse<string>.FailResponse($"Internal server error: {ex.Message}"));
        }
    }

    /// <summary>
    /// Get product by ID
    /// </summary>
    [HttpGet("{id}")]
    public async Task<IActionResult> GetProductById(int id)
    {
        try
        {
            var product = await _productService.GetByIdAsync(id);
            if (product == null)
                return NotFound(ApiResponse<string>.FailResponse("Product not found"));

            return Ok(ApiResponse<ProductDto>.SuccessResponse(product, "Product retrieved"));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR in GetProductById: {ex.Message}");
            return StatusCode(500, ApiResponse<string>.FailResponse($"Internal server error: {ex.Message}"));
        }
    }

    /// <summary>
    /// Get all brands
    /// </summary>
    [HttpGet("brands")]
    public async Task<IActionResult> GetBrands()
    {
        try
        {
            var brands = await _productService.GetBrandsAsync();
            return Ok(ApiResponse<IEnumerable<string>>.SuccessResponse(brands, "Brands retrieved"));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR in GetBrands: {ex.Message}");
            return StatusCode(500, ApiResponse<string>.FailResponse($"Internal server error: {ex.Message}"));
        }
    }

    /// <summary>
    /// Get all categories
    /// </summary>
    [HttpGet("categories")]
    public async Task<IActionResult> GetCategories()
    {
        try
        {
            var categories = await _productService.GetCategoriesAsync();
            return Ok(ApiResponse<IEnumerable<string>>.SuccessResponse(categories, "Categories retrieved"));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERROR in GetCategories: {ex.Message}");
            return StatusCode(500, ApiResponse<string>.FailResponse($"Internal server error: {ex.Message}"));
        }
    }

    /// <summary>
    /// Create product (Admin only)
    /// </summary>
    [Authorize(Roles = "Admin")]
    [HttpPost]
    public async Task<IActionResult> CreateProduct([FromBody] ProductDto dto)
    {
        try
        {
            if (!ModelState.IsValid)
